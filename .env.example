# Public origin of the deployed app (used by adapter-node for cookies, redirects
# and form actions). Set it to the final HTTPS URL when running behind a proxy.
ORIGIN=https://cinema.example.com

# Real account API. When omitted, the app uses https://juniorsbootcamp.ru.
BACKEND_URL=https://juniorsbootcamp.ru

# Docker Compose only: host port mapped to the container's port 3000.
APP_PORT=3000
